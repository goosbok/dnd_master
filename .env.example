# Ключ Kimi Code API (Kimi Code Console) или Kimi Platform (platform.moonshot.ai).
# Без ключа игра работает на ScriptedDM — детерминированном фейке.
MOONSHOT_API_KEY=sk-...

# Необязательно:
# MOONSHOT_BASE_URL=https://api.kimi.ai/coding/v1   # Kimi Code API (по умолчанию)
# MOONSHOT_BASE_URL=https://api.moonshot.ai/v1      # Kimi Platform (pay-as-you-go)
# MOONSHOT_MODEL=kimi-for-coding-highspeed
